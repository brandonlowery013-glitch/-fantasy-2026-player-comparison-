{
  "name": "ctd-background-splits",
  "main": "worker.mjs",
  "account_id": "91d40cf5a86348b4c84fb3f30f253cbf",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "vars": {"PROPS_RELAY_URL": "https://frontend-ctd-cloudflare-work.chuck-the-duke-preview.pages.dev/api/internal/props-refresh", "AVAILABILITY_ENABLED":"true", "QB_PROJECTIONS_ENABLED":"true", "PERSONNEL_GAME_ENABLED":"true", "SPREAD_MODEL_ENABLED":"true", "MONEYLINE_MODEL_ENABLED":"true", "JOINT_MODEL_ENABLED":"true"},
  "triggers": {"crons": ["*/15 * * * *"]},
  "durable_objects": {"bindings": [{"name": "SPLITS_STORE", "class_name": "SplitsStore"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["SplitsStore"]}],
  "observability": {"enabled": true}
}
