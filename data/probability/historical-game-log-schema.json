{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fantasy 2026 Historical Game Log Row",
  "type": "object",
  "required": ["player","season","week","team","opponent","played","role_regime_id","source"],
  "properties": {
    "player": {"type":"string"},
    "position": {"type":["string","null"],"enum":["QB","RB","WR","TE",null]},
    "season": {"type":"integer","minimum":2021,"maximum":2025},
    "week": {"type":"integer","minimum":1,"maximum":18},
    "team": {"type":"string"},
    "opponent": {"type":"string"},
    "home": {"type":["boolean","null"]},
    "played": {"type":"boolean"},
    "started": {"type":["boolean","null"]},
    "inactive": {"type":["boolean","null"]},
    "inactive_reason": {"type":["string","null"]},
    "partial_game": {"type":["boolean","null"]},
    "partial_game_reason": {"type":["string","null"]},
    "injury_limited": {"type":["boolean","null"]},
    "injury_status_pre_game": {"type":["string","null"]},
    "injury_body_part": {"type":["string","null"]},
    "role_regime_id": {"type":"string","minLength":1},
    "role_regime_reason": {"type":["string","null"]},
    "depth_chart_role": {"type":["string","null"]},
    "team_change_from_prior_game": {"type":["boolean","null"]},
    "starting_qb": {"type":["string","null"]},
    "head_coach": {"type":["string","null"]},
    "offensive_coordinator": {"type":["string","null"]},
    "primary_play_caller": {"type":["string","null"]},
    "pass_attempts": {"type":["number","null"],"minimum":0},
    "pass_yards": {"type":["number","null"],"minimum":0},
    "pass_tds": {"type":["number","null"],"minimum":0},
    "rush_attempts": {"type":["number","null"],"minimum":0},
    "rush_yards": {"type":["number","null"]},
    "rush_tds": {"type":["number","null"],"minimum":0},
    "targets": {"type":["number","null"],"minimum":0},
    "receptions": {"type":["number","null"],"minimum":0},
    "receiving_yards": {"type":["number","null"]},
    "receiving_tds": {"type":["number","null"],"minimum":0},
    "offensive_snaps": {"type":["number","null"],"minimum":0},
    "snap_share": {"type":["number","null"],"minimum":0,"maximum":1},
    "routes_run": {"type":["number","null"],"minimum":0},
    "route_share": {"type":["number","null"],"minimum":0,"maximum":1},
    "team_dropbacks": {"type":["number","null"],"minimum":0},
    "target_share": {"type":["number","null"],"minimum":0,"maximum":1},
    "air_yards": {"type":["number","null"]},
    "air_yards_share": {"type":["number","null"],"minimum":0,"maximum":1},
    "carry_share": {"type":["number","null"],"minimum":0,"maximum":1},
    "red_zone_targets": {"type":["number","null"],"minimum":0},
    "inside_10_targets": {"type":["number","null"],"minimum":0},
    "inside_5_targets": {"type":["number","null"],"minimum":0},
    "end_zone_targets": {"type":["number","null"],"minimum":0},
    "red_zone_receptions": {"type":["number","null"],"minimum":0},
    "inside_10_receptions": {"type":["number","null"],"minimum":0},
    "inside_5_receptions": {"type":["number","null"],"minimum":0},
    "red_zone_receiving_tds": {"type":["number","null"],"minimum":0},
    "inside_10_receiving_tds": {"type":["number","null"],"minimum":0},
    "inside_5_receiving_tds": {"type":["number","null"],"minimum":0},
    "red_zone_carries": {"type":["number","null"],"minimum":0},
    "goal_line_carries": {"type":["number","null"],"minimum":0},
    "red_zone_rush_attempts": {"type":["number","null"],"minimum":0},
    "inside_10_rush_attempts": {"type":["number","null"],"minimum":0},
    "inside_5_rush_attempts": {"type":["number","null"],"minimum":0},
    "red_zone_rush_tds": {"type":["number","null"],"minimum":0},
    "inside_10_rush_tds": {"type":["number","null"],"minimum":0},
    "inside_5_rush_tds": {"type":["number","null"],"minimum":0},
    "red_zone_pass_attempts": {"type":["number","null"],"minimum":0},
    "inside_10_pass_attempts": {"type":["number","null"],"minimum":0},
    "inside_5_pass_attempts": {"type":["number","null"],"minimum":0},
    "red_zone_pass_tds": {"type":["number","null"],"minimum":0},
    "inside_10_pass_tds": {"type":["number","null"],"minimum":0},
    "inside_5_pass_tds": {"type":["number","null"],"minimum":0},
    "team_offensive_plays": {"type":["number","null"],"minimum":0},
    "team_pass_rate": {"type":["number","null"],"minimum":0,"maximum":1},
    "neutral_pass_rate": {"type":["number","null"],"minimum":0,"maximum":1},
    "seconds_per_play": {"type":["number","null"],"minimum":0},
    "team_points": {"type":["number","null"],"minimum":0},
    "opponent_points": {"type":["number","null"],"minimum":0},
    "final_point_differential": {"type":["number","null"]},
    "roof": {"type":["string","null"]},
    "surface": {"type":["string","null"]},
    "temperature_f": {"type":["number","null"]},
    "wind_mph": {"type":["number","null"],"minimum":0},
    "precipitation": {"type":["string","null"]},
    "opponent_defense_bucket": {"type":["string","null"]},
    "data_quality_flags": {"type":"array","items":{"type":"string","enum":["PARTIAL_GAME","INJURY_LIMITED","ROLE_CHANGE","TEAM_CHANGE","QB_CHANGE","COACH_OR_PLAYCALLER_CHANGE","MISSING_USAGE_DATA","MISSING_CONTEXT_DATA","SOURCE_CONFLICT","MANUAL_REVIEW"]},"uniqueItems":true},
    "source": {"type":"string"},
    "source_url": {"type":["string","null"]},
    "usage_source": {"type":["string","null"]},
    "usage_source_url": {"type":["string","null"]},
    "context_source": {"type":["string","null"]},
    "context_source_url": {"type":["string","null"]},
    "high_value_usage_source": {"type":["string","null"]},
    "high_value_usage_source_date": {"type":["string","null"]},
    "source_date": {"type":["string","null"]}
  },
  "allOf": [
    {"if":{"properties":{"played":{"const":false}},"required":["played"]},"then":{"properties":{"inactive":{"const":true}}}},
    {"if":{"properties":{"partial_game":{"const":true}},"required":["partial_game"]},"then":{"required":["partial_game_reason"]}}
  ],
  "additionalProperties": false
}
