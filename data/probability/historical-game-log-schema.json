{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fantasy 2026 Historical Game Log Row",
  "type": "object",
  "required": ["player","season","week","team","opponent","played","source"],
  "properties": {
    "player": {"type":"string"},
    "season": {"type":"integer","minimum":2021,"maximum":2025},
    "week": {"type":"integer","minimum":1,"maximum":18},
    "team": {"type":"string"},
    "opponent": {"type":"string"},
    "played": {"type":"boolean"},
    "started": {"type":["boolean","null"]},
    "pass_attempts": {"type":["number","null"],"minimum":0},
    "pass_yards": {"type":["number","null"],"minimum":0},
    "pass_tds": {"type":["number","null"],"minimum":0},
    "rush_attempts": {"type":["number","null"],"minimum":0},
    "rush_yards": {"type":["number","null"]},
    "rush_tds": {"type":["number","null"],"minimum":0},
    "targets": {"type":["number","null"],"minimum":0},
    "receptions": {"type":["number","null"],"minimum":0},
    "receiving_yards": {"type":["number","null"]},
    "receiving_tds": {"type":["number","null"],"minimum":0},
    "snap_share": {"type":["number","null"],"minimum":0,"maximum":1},
    "route_share": {"type":["number","null"],"minimum":0,"maximum":1},
    "target_share": {"type":["number","null"],"minimum":0,"maximum":1},
    "air_yards_share": {"type":["number","null"],"minimum":0,"maximum":1},
    "red_zone_targets": {"type":["number","null"],"minimum":0},
    "red_zone_carries": {"type":["number","null"],"minimum":0},
    "goal_line_carries": {"type":["number","null"],"minimum":0},
    "source": {"type":"string"},
    "source_url": {"type":["string","null"]},
    "source_date": {"type":["string","null"]}
  },
  "additionalProperties": false
}
