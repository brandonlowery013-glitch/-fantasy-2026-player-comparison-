  },
  "ticket_outputs": [
    "legs",
    "sportsbook",
    "combined_odds",
    "price_status",
    "model_hit_probability",
    "implied_probability",
    "parlay_expected_value",
    "confidence",
    "correlation_status",
    "correlation_warning",
    "strongest_leg",
    "weakest_leg",
    "grade",
    "verdict",
    "explanation"
