  "authority": "DOWNSTREAM_BETTING_DECISION_ONLY",
  "purpose": "Evaluate and generate 2-12 leg model-supported parlays from already-approved standalone game-bet and player-prop recommendations without allowing parlay logic or sportsbook pricing to mutate football projections.",
  "supported_leg_counts": {"minimum": 2, "maximum": 12},
  "modes": ["MODEL_PICKS", "BUILD_YOUR_OWN"],
