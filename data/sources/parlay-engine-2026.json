    "same_game_independence_assumption_allowed": false,
    "cross_game_independence_allowed_when_no_shared_football_driver": true,
    "correlation_source": "data/sources/correlation-modeling-2026.json",
    "joint_method": "GAUSSIAN_COPULA_MONTE_CARLO",
    "default_samples": 32768,
    "minimum_samples": 4096,
    "unknown_same_game_relationship_result": "CORRELATION_REVIEW_REQUIRED",
    "known_relationship_may_silently_fall_back_to_independence": false
  },
  "price_contract": {
