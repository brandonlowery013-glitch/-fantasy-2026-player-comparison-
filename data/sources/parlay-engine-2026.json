    "cross_book_ticket_may_be_called_executable": false,
    "standard_cross_game_reference_payout_method": "MULTIPLY_DECIMAL_LEG_ODDS",
    "same_game_parlay_actual_book_quote_required_for_actionable_ev": true,
    "synthetic_same_game_payout_may_be_displayed_as_executable": false,
    "actual_ticket_quote_fields": ["sportsbook", "american_odds", "quoted_at"],
