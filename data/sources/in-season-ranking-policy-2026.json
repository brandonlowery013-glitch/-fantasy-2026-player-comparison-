      "numeric_injury_effects": "QUESTIONABLE_LABEL_ONLY_DOUBTFUL_OUT_IR_REQUIRE_SOURCED_EVIDENCE",
      "reference_urls": [
        "https://help.yahoo.com/kb/SLN28136.html",
        "https://www.fantasypros.com/nfl/players/injuries.php",
        "https://www.fantasypros.com/nfl/rankings/ppr-flex.php"
